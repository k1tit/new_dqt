{
  "description": "Logical dm_product_general — encoded as checker filters/joins (no physical DM table).",
  "source": "Confluence Product General / Jaroslaw Kochanski; last updated Jul 15, 2025; field map v7",
  "note": "Cluster (SAP_CLUSTER) is also available in all conditions. Destination: application_data_quality_ca_data_control_center_golden.dm_product_general (truncate/insert).",
  "versions": {
    "v6": "old_material_code (uniqueness)",
    "v7": "bpp_brand_code, bpp_flavour_code, bpp_pack_type_code, bpp_pack_size_code, bpp_sales_unit_code (BPP rules)"
  },
  "is_basic_scope": {
    "definition": "IF (LVORM <> 'X' AND MSTAE <> '99') AND MTART NOT IN (ZCDN, ZSPN) THEN '1' ELSE '0'",
    "note": "Moving all refiltration to this flag. DQ Conformity on dm_product_general evaluates is_basic_scope=1 unless rule technical says otherwise."
  },
  "sources": [
    {"type": "DM", "place": "MARA", "alias": "m", "filtering": null},
    {"type": "DM", "place": "MAKT", "alias": "a1", "filtering": "SPRAS = 'E'"},
    {
      "type": "DM",
      "place": "AUSP",
      "alias": "au",
      "filtering": "If for the same ATINN, OBJEK, SAP_CLUSTER, KLART more than one row then take higher ATZHL"
    },
    {"type": "DM", "place": "CABN", "alias": "ca", "filtering": "ATNAM IN (ATNAM from ausp_cabn_filter.json)"},
    {"type": "DM", "place": "T134T", "alias": "a2", "filtering": "SPRAS = 'E'"},
    {"type": "DM", "place": "T023T", "alias": "a3", "filtering": "SPRAS = 'E'"},
    {"type": "DM", "place": "T006A", "alias": "a4", "filtering": "SPRAS = 'E'"},
    {"type": "DM", "place": "T141T", "alias": "a5", "filtering": "SPRAS = 'E'"},
    {"type": "DM", "place": "ZMDM_BP_CODE", "alias": "bp", "filtering": null},
    {"type": "DM", "place": "CAWNT", "alias": "ct", "filtering": "SPRAS = 'E'"},
    {"type": "DM", "place": "CAWN", "alias": "cn", "filtering": null},
    {
      "type": "DM",
      "place": "ZMDM_BPP_CODET",
      "alias": "bpp",
      "filtering": "inner join with ZMDM_BPP_CODE on MANDT and ATWRT"
    },
    {
      "type": "manual",
      "place": "material_type_group_mapping",
      "alias": "mtg",
      "filtering": "json files/material_type_group_mapping.json (future: switch to SAP)"
    },
    {"type": "DM", "place": "MARM", "alias": "uom", "filtering": null},
    {"type": "DM", "place": "ZMDM_PACK_CODE", "alias": "pc", "filtering": null}
  ],
  "joins": [
    "m LEFT JOIN a1 ON m.MATNR = a1.MATNR",
    "m LEFT JOIN a2 ON m.MTART = a2.MTART",
    "m LEFT JOIN a4 ON m.MEINS = a4.MSEHI",
    "m LEFT JOIN a3 ON m.MATKL = a3.MATKL",
    "m LEFT JOIN a5 ON m.MSTAE = a5.MMSTA",
    "LEFT JOIN au ON RIGHT('000000000000000000'+m.MATNR,18)=RIGHT('000000000000000000'+au.OBJEK,18)",
    "au INNER JOIN ca ON au.ATINN = ca.ATINN",
    "au LEFT JOIN bp ON LEFT(au.ATWRT[ATNAM='CCHBC_BPP_CODE'],4) = bp.ATWRT4",
    "au LEFT JOIN cn ON au.ATWRT = cn.ATWRT AND au.ATINN = cn.ATINN",
    "cn LEFT JOIN ct ON cn.ATINN = ct.ATINN AND cn.ATZHL = ct.ATZHL",
    "au LEFT JOIN bpp ON au.ATWRT[ATNAM='CCHBC_BPP_CODE'] = bpp.ATWRT",
    "m LEFT JOIN mtg ON m.MATKL = mtg.material_group_code AND m.MTART = mtg.material_type_code",
    "LEFT JOIN uom ON m.MATNR = uom.MATNR (material_code)",
    "LEFT JOIN pc ON RIGHT(au.ATWRT[ATNAM='CCHBC_BPP_CODE'],4) = pc.PACKAGE_CODE"
  ],
  "config_files": {
    "ausp_cabn_filter": "json files/ausp_cabn_filter.json",
    "material_type_group_mapping": "json files/material_type_group_mapping.json"
  },
  "field_map": {
    "material_code": "m.MATNR",
    "material_description": "a1.MAKTX",
    "ean_code": "m.EAN11",
    "ban_code": "m.WRKST",
    "gross_weight": "m.BRGEW",
    "weight_unit": "m.GEWEI",
    "net_weight": "m.NTGEW",
    "temperature_condition_code": "m.TEMPB",
    "gds_relevant_flag": "m.GDS_RELEVANT",
    "material_group_code": "m.MATKL",
    "material_group_name": "a3.WGBEZ60",
    "material_type_group_name": "mtg.material_type_group_name",
    "base_unit_of_measure_code": "m.MEINS",
    "base_unit_of_measure_name": "a4.MSEHL",
    "manufacturer_part_number": "m.MFRPN",
    "total_shelf_life": "m.MHDHB",
    "remaining_shelf_life": "m.MHDRZ",
    "material_status_code": "m.MSTAE",
    "material_status_name": "a5.MTSTB",
    "material_type_code": "m.MTART",
    "material_type_name": "a2.MTBEZ",
    "material_type_name_unified": "CASE MTART groups -> Finished Goods / Raw Material and Semi- FG / Spare Parts / Equipment / Concentrate KITs / Services / Settlement",
    "general_item_category_group_code": "m.MTPOS_MARA",
    "deletion_flag": "m.LVORM",
    "last_change_date": "m.LAEDA",
    "creation_date": "m.ERSDA",
    "reference_packaging_material_code": "m.RMATP",
    "coffee_channel_code": "au.ATWRT ATNAM=CCHBC_COFFEE_CHANNEL",
    "coffee_channel_name": "ct.ATWTB ATNAM=CCHBC_COFFEE_CHANNEL",
    "coffee_class_code": "au.ATWRT ATNAM=CCHBC_COFFEE_CLASS",
    "coffee_class_name": "ct.ATWTB ATNAM=CCHBC_COFFEE_CLASS",
    "coffee_format_code": "au.ATWRT ATNAM=CCHBC_COFFEE_FORMAT",
    "coffee_format_name": "ct.ATWTB ATNAM=CCHBC_COFFEE_FORMAT",
    "coffee_method_code": "au.ATWRT ATNAM=CCHBC_COFFEE_METHOD",
    "coffee_method_name": "ct.ATWTB ATNAM=CCHBC_COFFEE_METHOD",
    "coffee_capsule_system_code": "au.ATWRT ATNAM=CCHBC_COFFEE_CAPSULE_SYSTEM",
    "coffee_capsule_system_name": "ct.ATWTB ATNAM=CCHBC_COFFEE_CAPSULE_SYSTEM",
    "bpp_code": "IF au.KLART='001' THEN au.ATWRT ATNAM=CCHBC_BPP_CODE",
    "bpp_name": "bpp.ATWTB",
    "bpp_bp_code": "IF au.KLART='001' THEN LEFT(BPP_CODE,4)",
    "bpp_bp_name": "bp.BEVPRD",
    "bpp_physical_state_code": "IF au.KLART='001' THEN SUBSTR(BPP_CODE,5,2)",
    "bpp_physical_state_name": "05=Packaged Finished Drink; 03=Postmix Syrup; 07=Premix Finished Drink",
    "bpp_package_code": "IF au.KLART='001' THEN LEFT(BPP_CODE,4)",
    "bpp_package_name": "max(pc.PACKAGE_CODE_D)",
    "spr_core_material_code": "IF au.KLART='001' THEN au.ATWRT ATNAM=SPR_MM_CORE_MATERIAL",
    "spr_core_material_name": "IF au.KLART='001' THEN ct.ATWTB ATNAM=SPR_MM_CORE_MATERIAL",
    "spr_shape_code": "IF au.KLART='001' THEN au.ATWRT ATNAM=SPR_MM_SHAPE",
    "spr_shape_name": "IF au.KLART='001' THEN ct.ATWTB ATNAM=SPR_MM_SHAPE",
    "spr_weight": "IF au.KLART='001' THEN au.ATFLV ATNAM=SPR_MM_WEIGHT",
    "spr_co2": "IF au.KLART='001' THEN au.ATFLV ATNAM=SPR_MM_CO2",
    "spr_recycle_content": "IF au.KLART='001' THEN au.ATFLV ATNAM=SPR_MM_RECYCLE_CONTENT",
    "volume": "m.VOLUM",
    "volume_unit": "m.VOLEH",
    "type_number": "au.ATWRT ATNAM=PM_TYPENUMBER",
    "sap_cluster": "m.SAP_CLUSTER",
    "uom_pal_conversion_numerator": "uom.UMREZ MEINH=PAL",
    "uom_pal_conversion_denominator": "uom.UMREN MEINH=PAL",
    "uom_pal_ean_code": "uom.EAN11 MEINH=PAL",
    "uom_cs_ean_code": "uom.EAN11 MEINH=CS",
    "uom_pc_ean_code": "uom.EAN11 MEINH=PC",
    "uom_pack_ean_code": "uom.EAN11 MEINH=PACK",
    "storage_conditions_code": "m.RAUBE",
    "is_basic_scope": "IF (LVORM<>'X' AND MSTAE<>'99') AND MTART NOT IN (ZCDN,ZSPN) THEN '1' ELSE '0'",
    "old_material_code": "m.BISMT",
    "bpp_brand_code": "bp.mvgr1",
    "bpp_flavour_code": "bp.mvgr2",
    "bpp_pack_type_code": "pc.pack_type",
    "bpp_pack_size_code": "pc.pack_size",
    "bpp_sales_unit_code": "pc.sales_unit"
  },
  "dq_rules_using_dm": ["RPCONF_166.1", "RPCONF_196.10", "RPCONF_196.11"],
  "dq_minimal_tables_for_current_rules": ["MARA", "MAKT"]
}
